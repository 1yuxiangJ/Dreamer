# Dreamer runtime configuration
# Copy to .env and replace the placeholder API keys.

# Chat model used by Awake and Sleep.
DEEPSEEK_API_KEY=__YOUR_DEEPSEEK_KEY__
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Embedding model used for Archival Fact retrieval.
EMBED_API_KEY=__YOUR_EMBEDDING_KEY__
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
EMBED_DIMENSIONS=1024

# Native setup only. Docker Compose supplies its own internal database URL.
DATABASE_URL=postgresql+asyncpg://dreamer:__YOUR_DB_PASSWORD__@localhost:5432/dreamer

# MCP service.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_PATH=/mcp

# Sleep scheduling. Disabled by default for predictable local development.
SLEEP_SCHEDULER_ENABLED=false
SLEEP_IDLE_THRESHOLD_SECONDS=1800
SLEEP_DAILY_CRON_HOUR=3
SLEEP_MAX_WALL_TIME_SECONDS=300
SLEEP_MAX_TOKENS=50000
SLEEP_MIN_ARCHIVAL_COUNT=10
SLEEP_SWAP_LOCK_TIMEOUT_MS=500
SLEEP_CORE_REPAIR_MAX_ATTEMPTS=2

# Awake and durable Remember worker guardrails.
AWAKE_REACT_RECURSION_LIMIT=8
AWAKE_LLM_TIMEOUT_SECONDS=20
AWAKE_LLM_MAX_RETRIES=1
AWAKE_OVERALL_TIMEOUT_SECONDS=45
MEMORY_WRITE_WORKER_ENABLED=true
MEMORY_WRITE_WORKER_POLL_SECONDS=1.0
MEMORY_WRITE_WORKER_MAX_ATTEMPTS=3
MEMORY_WRITE_JOB_STALE_SECONDS=300

EMBEDDING_CACHE_SIZE=256
LOG_LEVEL=INFO
LOG_FILE=logs/dreamer.log

# Dreamer currently has a single-user memory space.
USER_ID=default
